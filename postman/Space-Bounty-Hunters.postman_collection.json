              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('huntId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
